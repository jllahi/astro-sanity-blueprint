    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/vercel": "^8.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/montserrat": "^5.2.8",
    "@sanity/astro": "^3.2.10",
    "@sanity/client": "^7.12.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^4.10.2",
    "@sanity/visual-editing": "^3.0.5",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@unpic/astro": "^1.0.1",
    "astro": "^5.14.1",
    "astro-portabletext": "^0.11.3",
    "astro-seo": "^0.8.4",
    "groq": "^4.10.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanity": "^4.10.2",
    "sanity-plugin-asset-source-unsplash": "^4.0.1",
