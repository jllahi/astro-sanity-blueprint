{
  "name": "astro-sanity-blueprint",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "check": "astro check",
    "dev": "astro dev",
    "format": "vp fmt . --write",
    "lint": "vp lint . --fix",
    "preview": "astro preview",
    "start": "astro dev",
    "extract-types": "sanity schema extract --enforce-required-fields",
    "predev-off": "pnpm run typegen",
    "typegen": "sanity schema extract --enforce-required-fields --path ./src/sanity/schema.json && sanity typegen generate",
    "prepare": "vp config"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/vercel": "^11.0.22",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@sanity/astro": "^4.1.0",
    "@sanity/client": "^8.17.0",
    "@sanity/icons": "^5.4.0",
    "@sanity/image-url": "^2.2.0",
    "@sanity/vision": "^6.24.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react-is": "^19.3.0",
    "astro": "^7.4.13",
    "astro-embed": "^0.14.0",
    "astro-expressive-code": "^0.44.4",
    "astro-portabletext": "^1.0.1",
    "astro-robots": "^2.3.1",
    "astro-seo": "^1.2.0",
    "date-fns": "^4.4.0",
    "groq": "^6.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "sanity": "^6.24.0",
    "sanity-plugin-asset-source-unsplash": "^7.0.31",
    "sanity-plugin-media": "^6.6.3",
    "styled-components": "^6.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@portabletext/types": "^4.0.2",
    "@sanity/types": "^6.24.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-eslint-parser": "^3.2.0",
    "astro-meta-tags": "^0.4.1",
    "astro-robots-txt": "^1.0.0",
    "eslint-plugin-astro": "^3.2.1",
    "sharp": "^0.35.5",
    "vite-plus": "catalog:"
