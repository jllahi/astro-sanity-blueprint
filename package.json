{
  "name": "astro-sanity-blueprint",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "check": "astro check",
    "dev": "astro dev",
    "format": "prettier -w .",
    "lint": "eslint --fix .",
    "preview": "astro preview",
    "start": "astro dev",
    "extract-types": "sanity schema extract --enforce-required-fields",
    "predev-off": "pnpm run typegen",
    "typegen": "sanity schema extract --enforce-required-fields --path ./src/sanity/schema.json && sanity typegen generate"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.7",
    "@astrojs/node": "^10.0.1",
    "@astrojs/react": "^5.0.0",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.1",
    "@astrojs/vercel": "^9.0.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/montserrat": "^5.2.8",
    "@sanity/astro": "^3.3.1",
    "@sanity/client": "^7.17.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.0.3",
    "@sanity/vision": "^5.15.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@unpic/astro": "^1.0.2",
    "astro": "^6.0.4",
    "astro-embed": "^0.12.0",
    "astro-expressive-code": "^0.41.7",
    "astro-portabletext": "^0.13.0",
    "astro-robots": "^2.3.1",
    "astro-seo": "^1.1.0",
    "date-fns": "^4.1.0",
    "groq": "^5.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^5.15.0",
    "sanity-plugin-asset-source-unsplash": "^7.0.5",
    "sanity-plugin-media": "^4.1.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.2",
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@portabletext/types": "^4.0.2",
    "@sanity/types": "^5.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "astro-eslint-parser": "^1.3.0",
    "astro-meta-tags": "^0.4.0",
    "astro-robots-txt": "^1.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.34.5",
    "typescript-eslint": "^8.57.0"
  }
