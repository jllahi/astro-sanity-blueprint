{
  "name": "astro-sanity-blueprint",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "check": "astro check",
    "dev": "astro dev",
    "format": "prettier -w .",
    "lint": "eslint --fix .",
    "preview": "astro preview",
    "start": "astro dev",
    "extract-types": "sanity schema extract --enforce-required-fields",
    "predev-off": "pnpm run typegen",
    "typegen": "sanity schema extract --enforce-required-fields --path ./src/sanity/schema.json && sanity typegen generate"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^10.1.4",
    "@astrojs/react": "^5.0.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^10.0.8",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@sanity/astro": "3.6.1",
    "@sanity/client": "^7.28.0",
    "@sanity/icons": "^3.8.0",
    "@sanity/image-url": "2.1.1",
    "@sanity/vision": "^5.31.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@types/react-is": "19.3.0",
    "@unpic/astro": "^1.0.2",
    "astro": "^6.4.8",
    "astro-embed": "0.14.0",
    "astro-expressive-code": "0.44.3",
    "astro-portabletext": "^0.13.0",
    "astro-robots": "^2.3.1",
    "astro-seo": "1.2.0",
    "date-fns": "4.4.0",
    "groq": "^5.31.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "sanity": "^5.31.2",
    "sanity-plugin-asset-source-unsplash": "^7.0.30",
    "sanity-plugin-media": "^4.3.6",
    "styled-components": "6.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@portabletext/types": "^4.0.2",
    "@sanity/types": "^5.31.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "astro-eslint-parser": "^1.4.0",
    "astro-meta-tags": "^0.4.1",
    "astro-robots-txt": "^1.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "3.10.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "3.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "typescript-eslint": "8.72.2"
