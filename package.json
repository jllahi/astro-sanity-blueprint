{
  "name": "astro-sanity-blueprint",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "check": "astro check",
    "dev": "astro dev",
    "format": "prettier -w .",
    "lint": "eslint --fix .",
    "preview": "astro preview",
    "start": "astro dev",
    "extract-types": "sanity schema extract --enforce-required-fields",
    "predev-off": "pnpm run typegen",
    "typegen": "sanity schema extract --enforce-required-fields --path ./src/sanity/schema.json && sanity typegen generate"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.17",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@sanity/astro": "^3.6.0",
    "@sanity/client": "^8.14.0",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.21.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@unpic/astro": "^1.0.2",
    "astro": "^7.4.4",
    "astro-embed": "^0.14.0",
    "astro-expressive-code": "^0.44.3",
    "astro-portabletext": "^1.0.1",
    "astro-robots": "^2.3.1",
    "astro-seo": "^1.2.0",
    "date-fns": "^4.4.0",
    "groq": "^6.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.21.0",
    "sanity-plugin-asset-source-unsplash": "^7.0.30",
    "sanity-plugin-media": "^6.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@portabletext/types": "^4.0.2",
    "@sanity/types": "^6.21.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "astro-eslint-parser": "^3.2.0",
    "astro-meta-tags": "^0.4.1",
    "astro-robots-txt": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8.72.1"
  }
