{
  "name": "astro-sanity-blueprint",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "check": "astro check",
    "dev": "astro dev",
    "format": "prettier -w .",
    "lint": "eslint --fix .",
    "preview": "astro preview",
    "start": "astro dev",
    "extract-types": "sanity schema extract --enforce-required-fields --path ./src/sanity/schema.json",
    "prebuild": "bun run typegen",
    "predev": "bun run typegen",
    "typegen": "bun run extract-types && sanity typegen generate"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.4.4",
    "@astrojs/react": "^4.4.0",
