---
// import type { Post } from '@/utils/sanity'
import type { Post, POST_QUERYResult, POSTS_QUERYResult } from '@/sanity.types'
import Card from '@/components/Card.astro'
import NoPosts from '@/components/NoPosts.astro'
import Welcome from '@/components/Welcome.astro'
import Layout from '@/layouts/Layout.astro'
import { loadQuery } from '@/sanity/load-query'
import { POSTS_QUERY } from '@/sanity/queries'

export const prerender = true

// const posts = await getPosts()
const { data: posts } = await loadQuery<POSTS_QUERYResult>({
  query: POSTS_QUERY,
})

// console.log('POSTS->', posts[0].coverImage.asset)
// console.log(posts[0].coverImage.asset.metadata.palette.dominant.background)
---

<Layout seo={{ title: 'The official Sanity integration for Astro' }}>
  <Welcome />

  <section class="flex flex-col">
    {
      posts.length && (
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
            Recent Posts
          </h2>
          <p class="mt-2 text-lg leading-8 text-gray-600">
            These {posts.length} blog posts are populated from your Sanity Studio.
          </p>
        </div>
      )
    }
    {
      posts.length ? (
        <div class="mt-6 space-y-12 border-t border-gray-200 pt-6">
          {posts.map((post: POST_QUERYResult) => (
            <div class="">
              <Card post={post} />
            </div>
          ))}
        </div>
      ) : (
        <NoPosts />
      )
    }
  </section>
</Layout>
