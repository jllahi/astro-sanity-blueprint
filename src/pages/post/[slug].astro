---
import type { PortableTextBlock } from '@portabletext/types'
import { Image } from '@unpic/astro'
import { PortableText } from 'astro-portabletext'
import Debug from '@/components/Debug.astro'
// import type { InferGetStaticParamsType } from 'astro'
import Layout from '@/layouts/Layout.astro'
import { getPostBySlug, getSlugsAllPosts } from '@/sanity/queries/post.groq'
import { urlForImage } from '@/sanity/url-image'
import { formatDate } from '@/utils'

export const prerender = true

export async function getStaticPaths() {
  const posts = await getSlugsAllPosts()

  return posts.map(({ slug }) => {
    return {
      params: {
        slug: slug.current,
      },
    }
  })
}

// type Params = InferGetStaticParamsType<typeof getStaticPaths>
// const { slug } = Astro.params as Params
const { params } = Astro

const post = await getPostBySlug(params.slug as string)
// console.log('🚀 ~ post:', post.coverImage)
---

<Layout seo={{ title: post.title, description: post.excerpt }}>
  <article class="grid gap-12">
    <div class="mb-6 grid gap-6 border-b border-gray-200 pb-6">
      <div class="flex max-w-3xl flex-col gap-6">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl lg:text-7xl">
          {post.title}
        </h1>
      </div>
      {
        /*
      <div class="flex max-w-3xl items-center gap-4">
        {
          post.author && post.author.firstName && post.author.lastName && (
            <Avatar person={post.author} date={post.date} />
          )
        }
      </div>
       */
      }
      <p class="text-sm text-black/60">
        {formatDate(post._createdAt)}
      </p>
    </div>
    <div class="grid max-w-4xl gap-2">
      <div class="">
        <Image
          src={urlForImage(post.coverImage).width(800).height(480).url()}
          alt={post.coverImage.alt}
          class="w-full rounded-2xl"
          width={800}
          height={480}
          loading={'eager'}
          transition:name={`post-image-${post.slug.current}`}
          placeholder={'lqip'}
          background={post.coverImage?.asset?.metadata?.lqip}
        />
      </div>
    </div>
    {
      post.content && (
        <div class="prose prose-a:text-blue-500 mt-2">
          <PortableText value={post.content as PortableTextBlock[]} />
        </div>
      )
    }
  </article>
  <Debug {...post} />
</Layout>
