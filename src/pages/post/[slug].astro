---
import { SanityImage } from "@sanity/astro/image";
import { getCollection } from "astro:content";

import PortableText from "@/components/content/PortableText.astro";
import Prose from "@/components/content/Prose.astro";
import Debug from "@/components/Debug.astro";
// import type { InferGetStaticParamsType } from 'astro'
import Layout from "@/layouts/Layout.astro";
import type { QueryPostBySlugResult } from "@/sanity/types";
import { formatDate } from "@/utils";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => {
    return {
      params: {
        slug: post.id,
      },
      props: { post },
    };
  });
}

// type Params = InferGetStaticParamsType<typeof getStaticPaths>
const { post: entry } = Astro.props;
const post = entry.data as unknown as NonNullable<QueryPostBySlugResult>;
// console.log('🚀 ~ post:', post.coverImage)
---

<Layout seo={{ title: post.title, description: post.excerpt }}>
  <article class="grid gap-12">
    <div class="mb-6 grid gap-6 border-b border-gray-200 pb-6">
      <div class="flex max-w-3xl flex-col gap-6">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl lg:text-7xl">
          {post.title}
        </h1>
      </div>
      {/*
      <div class="flex max-w-3xl items-center gap-4">
        {
          post.author && post.author.firstName && post.author.lastName && (
            <Avatar person={post.author} date={post.date} />
          )
        }
      </div>
       */}
      <p class="text-sm text-black/60">{formatDate(post._createdAt)}</p>
    </div>
    <div class="grid max-w-4xl gap-2">
      <div class="">
        <SanityImage
          src={post.coverImage}
          alt={post.coverImage.alt || post.title}
          class="w-full rounded-2xl"
          width={800}
          height={480}
          loading="eager"
          transition:name={`post-image-${post.slug.current}`}
          placeholder="blur"
        />
      </div>
    </div>
    {post.content && (
      <Prose>
        <PortableText value={post.content} />
      </Prose>
    )}
  </article>
  <Debug {...post} />
</Layout>
