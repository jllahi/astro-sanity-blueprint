---
import { isImageWithAsset, SanityImage as SanityImageComponent } from "@sanity/astro/image";

const { node } = Astro.props;
const { width = 960 } = Astro.props;
---

{isImageWithAsset(node?.image) && (
  <SanityImageComponent
    src={node.image}
    width={Number(width)}
    alt={node.alt || ""}
    title={node.alt}
    placeholder="blur"
  />
)}
