---
import type { SEOProps } from 'astro-seo'
import { SEO } from 'astro-seo'
import { SITE_DESCRIPTION, SITE_IMAGE, SITE_TITLE } from '@/consts'

interface Props {
  seo?: SEOProps
}

const { seo } = Astro.props

// Open Graph and Twitter need absolute URLs for the preview image.
const title = seo?.title || SITE_TITLE
const description = seo?.description || SITE_DESCRIPTION
const image = new URL(seo?.openGraph?.basic.image ?? SITE_IMAGE, Astro.site ?? Astro.url).href
---

<SEO
  titleTemplate={`%s | ${SITE_TITLE}`}
  title={title}
  description={description}
  openGraph={{
    basic: {
      title: seo?.openGraph?.basic.title || title,
      type: seo?.openGraph?.basic.type || 'website',
      image,
    },
  }}
  twitter={{
    card: 'summary_large_image',
    title: seo?.twitter?.title || title,
    description: seo?.twitter?.description || description,
    image,
  }}
/>
