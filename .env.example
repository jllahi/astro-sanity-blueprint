# Copy this file to `.env` (gitignored) and fill in the values you need.
# `astro dev` reads it automatically. `astro build` does not pass it to the Astro
# config, so for a local preview build use the inline form documented in the README.

# Preview (draft) mode. When `true`, pages query Sanity with the `drafts`
# perspective and unpublished changes become visible.
# Never enable this on a production deployment: it serves unpublished content.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false

# Viewer token for the dataset. Required when preview mode is enabled.
# Create one in sanity.io/manage -> API -> Tokens with the Viewer permission.
# Server-only: it is never sent to the browser.
SANITY_API_READ_TOKEN=
